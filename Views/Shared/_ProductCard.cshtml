@model AspNetWeek2.Mvc.ViewModels.ProductListItemViewModel

<div class="product-card">
    <h3>@Model.Name</h3>

    <p class="product-meta">
        Nhóm: @Model.CategoryName
    </p>

    <p class="product-price">
        @($"{Model.Price:N0} VND")
    </p>

    <p>
        Số lượng: <strong>@Model.Stock</strong>
    </p>

    <div class="card-actions">
        <a class="btn btn-light"
           asp-controller="Products"
           asp-action="Detail"
           asp-route-id="@Model.Id">
            Xem
        </a>
    </div>
</div>