@model List<AspNetWeek2.Mvc.Models.Category>

@{
    ViewData["Title"] = "Category & Product Relationship";
}

<div class="container mt-4">
    <h2 class="dashboard-title">Category & Product Relationship</h2>

    <table class="table relationship-table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Products</th>
                <th>Relationship</th>
                <th>DbSet</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="font-weight-bold">@category.Name</td>
                    
                    <td>
                        @if (category.Products != null && category.Products.Any())
                        {
                            @string.Join(", ", category.Products.Select(p => p.Name))
                        }
                        else
                        {
                            <span class="text-muted">No products</span>
                        }
                    </td>
                    
                    <td>1 - Many</td>
                    
                    <td>@(category == Model.First() ? "Categories" : "Products")</td>
                    
                    <td>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@category.Id" class="text-primary text-decoration-none">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>