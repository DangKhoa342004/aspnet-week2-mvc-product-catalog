@model List<AspNetWeek2.Mvc.Models.Order>

@{
    ViewData["Title"] = "Orders List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Orders List</h2>
        <a asp-action="Create" class="btn btn-primary font-weight-bold">Create New Order</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-box">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card card-custom">
        <table class="table table-hover mb-0">
            <thead class="table-header-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Product Name</th>
                    <th>Ngày tạo</th>
                    <th>Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">#@order.Id</td>
                            <td>@order.CustomerName</td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    @string.Join(", ", order.OrderItems.Select(i => i.Product?.Name ?? "Không rõ"))
                                }
                                else
                                {
                                    <span class="text-muted">Không có sản phẩm</span>
                                }
                            </td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-primary font-weight-bold">@order.TotalAmount.ToString("N0") VND</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có đơn hàng nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>