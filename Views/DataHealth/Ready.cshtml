@model AspNetWeek2.Mvc.ViewModels.DataHealthViewModel

@{
    ViewData["Title"] = "Data Health Check";
}

<div class="container mt-4">
    <h2 class="dashboard-title">Health Check - /health/ready</h2>

    <table class="table relationship-table">
        <thead>
            <tr>
                <th>Check</th>
                <th>Status</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="font-weight-bold">@item.Check</td>
                    <td>
                        <span class="badge @(item.Status == "OK" ? "badge-success-custom" : "badge-danger-custom")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.Note</td>
                </tr>
            }
        </tbody>
    </table>
</div>