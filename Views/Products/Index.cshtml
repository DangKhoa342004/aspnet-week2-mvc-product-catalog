@model List<ProductListItemViewModel>

@{
    ViewData["Title"] = "Product Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="dashboard-title">Data Layer Dashboard</h2>
        <div class="flow-steps">
            <div class="step-card">Controller</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Service</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Repository</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">DbContext</div>
            <div class="flow-arrow">&rarr;</div>
            <div class="step-card">Database</div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-box">
    <strong>Tổng số sản phẩm:</strong> @totalItems
</div>

@if (Model.Count == 0)
{
    <p>Chưa có sản phẩm nào trong hệ thống.</p>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <partial name="_ProductCard" model="item" />
        }
    </div>
}