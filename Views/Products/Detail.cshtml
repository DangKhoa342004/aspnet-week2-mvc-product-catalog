@model ProductDetailViewModel

@{
    ViewData["Title"] = "Product Detail";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Product Detail</h2>
        <p class="page-description">
            Thông tin chi tiết của sản phẩm trong kho.
        </p>
    </div>

    <a class="btn btn-light" href="/Products">
        Quay lại danh sách
    </a>
</div>

<div class="detail-layout">
    <div>
        <table class="table table-bordered">
            <tr>
                <th>ID</th>
                <td>@Model.Id</td>
            </tr>

            <tr>
                <th>Tên sản phẩm</th>
                <td>@Model.Name</td>
            </tr>

            <tr>
                <th>Nhóm sản phẩm</th>
                <td>@Model.Category</td>
            </tr>

            <tr>
                <th>Giá bán</th>
                <td>@Model.PriceText</td>
            </tr>

            <tr>
                <th>Số lượng tồn kho</th>
                <td>@Model.Stock</td>
            </tr>

            <tr>
                <th>Giá trị tồn kho</th>
                <td>@Model.InventoryValueText</td>
            </tr>

        </table>
    </div>
</div>
